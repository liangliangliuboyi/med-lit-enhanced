{
  "_comment": "配置模板。复制为 config.json 后可自由修改；密钥请写进 .env 或系统环境变量，不要写在这里。config.local.json 可覆盖本文件的任意字段（已 gitignore）。检索范围固定为全 PubMed，不做刊源或学科限制。",
  "provider": {
    "name": "siliconflow",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key_env": "SILICONFLOW_API_KEY",
    "rerank": {
      "enabled": true,
      "model": "Qwen/Qwen3-Reranker-8B",
      "endpoint": "https://api.siliconflow.cn/v1/rerank",
      "api_key_env": "SILICONFLOW_API_KEY"
    },
    "embed": {
      "enabled": false,
      "model": "Qwen/Qwen3-Embedding-8B",
      "api_key_env": "SILICONFLOW_API_KEY"
    }
  },
  "pubmed": {
    "api_key_env": "NCBI_API_KEY",
    "tool": "medlit-agent",
    "email": "",
    "_comment": "email 必须由使用者填自己的邮箱（NCBI 要求：一旦有人违规使用导致 IP 被限流，需要能联系到本人）。不要填别人的邮箱。首次运行 ask.py 会检查这一项并主动提醒补齐；也可用 --setup 由向导采集。"
  },
  "models": {
    "chain": {
      "planner": [
        "deepseek-ai/DeepSeek-V3.2",
        "deepseek-ai/DeepSeek-V3.1-Terminus",
        "Qwen/Qwen3-14B",
        "Qwen/Qwen3-32B"
      ],
      "reader": [
        "deepseek-ai/DeepSeek-V3.2",
        "deepseek-ai/DeepSeek-V3.1-Terminus",
        "Qwen/Qwen3-14B",
        "Qwen/Qwen2.5-72B-Instruct"
      ],
      "critic": [
        "deepseek-ai/DeepSeek-R1",
        "deepseek-ai/DeepSeek-V3.2",
        "Qwen/Qwen3-14B"
      ],
      "writer": [
        "deepseek-ai/DeepSeek-V3.2",
        "deepseek-ai/DeepSeek-V3.1-Terminus",
        "Qwen/Qwen3-14B"
      ],
      "fast": [
        "Qwen/Qwen2.5-7B-Instruct",
        "Qwen/Qwen3-14B",
        "Qwen/Qwen3.5-9B"
      ]
    }
  },
  "retrieval": {
    "rounds": 2,
    "expand_when_below": 16,
    "retmax_per_query": 20,
    "retmax_per_query_round2": 12,
    "max_papers": 8,
    "fulltext_limit": 4,
    "min_year": 2015,
    "require_abstract": true,
    "min_abstract_chars": 200,
    "research_min_abstract_chars": 300,
    "research_only": false,
    "exclude_pub_types": [
      "Review",
      "Systematic Review",
      "Meta-Analysis",
      "Case Reports",
      "Editorial",
      "Comment",
      "Letter",
      "News",
      "Published Erratum",
      "Retraction of Publication",
      "Retracted Publication",
      "Preprint",
      "Duplicate of the same article",
      "Comment on a Article"
    ],
    "exclude_animals": true,
    "languages": [
      "english"
    ],
    "expand_by_links": true,
    "expand_by_references": true,
    "max_link_expansion": 15,
    "max_snowball_titles": 3,
    "include_preprints": false,
    "preprint_limit": 15,
    "max_revisions": 2,
    "rewrite_on_structure_fail": true,
    "cross_check_relevance": true,
    "verify_claims": true,
    "claim_check_limit": 12
  },
  "runtime": {
    "timeout": 180,
    "max_retries": 3,
    "model_call_budget": 240,
    "reader_timeout": 90,
    "max_tokens": 4000,
    "temperature_plan": 0.15,
    "temperature_reader": 0.1,
    "temperature_writer": 0.3,
    "workers": 3,
    "price_per_million_tokens": 0.0
  },
  "paths": {
    "runs_root": "./runs"
  }
}
