# ============================================================================
# 复制本文件为 .env 后填写。.env 已被 .gitignore 排除，永远不要提交。
#
#   Windows PowerShell:  copy .env.example .env
#   Git Bash:            cp .env.example .env
#
# 也可以不建 .env，直接设系统环境变量（更安全，不会误提交）。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 模型服务端点（必填）
# ---------------------------------------------------------------------------
# 方案 A：硅基流动（国内直连、开箱即用、模型池丰富）
#   注册 https://cloud.siliconflow.cn ，在「账户」页拿 API Key
SILICONFLOW_API_KEY=

# 方案 B：任何 OpenAI 兼容端点。改 config.json 的 provider.base_url 即可，
#         例如 DeepSeek: https://api.deepseek.com/v1
#         Kimi:      https://api.moonshot.cn/v1
#         OpenAI:    https://api.openai.com/v1
#         本地 Ollama: http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# 2. NCBI E-utilities API key（选填但强烈建议）
# ---------------------------------------------------------------------------
# 无 key：限速 3 请求/秒（本项目默认节流 2.8/s，够用）
# 有 key：限速 10 请求/秒
# 申请：https://www.ncbi.nlm.nih.gov/account/settings/ → API Key Management
NCBI_API_KEY=

# ---------------------------------------------------------------------------
# 3. 你的邮箱（NCBI 要求分布式软件登记 tool + email）
# ---------------------------------------------------------------------------
# 用于 NCBI 在你违反使用政策时联系你。填你自己的真实邮箱。
# 注意：这是「软件开发者」邮箱，不是终端使用者的邮箱。
NCBI_EMAIL=
